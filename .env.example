# Copy to .env and adjust. Authentication uses Application Default Credentials
# (`gcloud auth application-default login`); there is no API key.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
ACME_LIVE_MODEL=gemini-live-2.5-flash-native-audio
ACME_TEXT_MODEL=gemini-2.5-flash
ACME_SENTIMENT_MODEL=gemini-2.5-flash-lite
ACME_EMBEDDING_MODEL=text-embedding-005
# ACME_FAQ_TIMEOUT_S=2.0
# ACME_FAQ_INDEX_PATH=data/index.npz
ACME_VOICE=Aoede
# Voice activity detection: silence (ms) that ends the candidate's turn, and how eagerly the
# model decides speech ended (high | low | default). Lower = faster replies, more interruptions.
ACME_VAD_SILENCE_MS=300
ACME_VAD_END_SENSITIVITY=high
# Languages the live speech recognizer may hear (BCP-47, comma-separated). Two keep mid-call
# ES<->EN switching; a single code forces one language.
ACME_TRANSCRIPTION_LANGUAGES=es-ES,en-US
# on | off (off skips post-call extraction and summary)
# ACME_POST_CALL=on
# on | off (off skips background sentiment scoring and the frustration offer)
# ACME_SENTIMENT=on
# json | gcs
ACME_STORAGE=json
ACME_DATA_DIR=data/conversations
# Only needed when ACME_STORAGE=gcs
ACME_BUCKET=
ACME_RETENTION_DAYS=30
# JSON list of allowed browser origins
ACME_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ACME_LOG_LEVEL=INFO
